# Copia este archivo como .env.local (en tu PC) o pon estas variables en Vercel.

# URL pública del sitio (cuando tengas dominio propio). En Vercel se detecta sola si la dejas vacía.
NEXT_PUBLIC_SITE_URL=

# Repositorio de GitHub en formato usuario/repositorio. Activa el modo GitHub del panel
# en producción: solo las cuentas con permiso de escritura en el repo pueden guardar.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# Las crea Keystatic automáticamente al configurar la GitHub App (ver README).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
